{
  "version": 2,
  "devCommand": "vite --port $PORT",
  "builds": [
    {
      "src": "api/**/*.ts",
      "use": "@vercel/node"
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/messages/(.*)",
      "dest": "/api/messages.ts?u=$1"
    },
    {
      "src": "/api/profile/(.*)",
      "dest": "/api/members.ts?username=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.ts"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
